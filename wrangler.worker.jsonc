{
  "name": "cavebettor-app",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CAVEBETTOR_MONTHLY_NGN": "5000",
    "PUBLIC_CONVEX_URL": "https://expert-goose-697.eu-west-1.convex.cloud",
    "PUBLIC_CONVEX_SITE_URL": "https://expert-goose-697.eu-west-1.convex.site",
    "PUBLIC_SITE_URL": "https://cavebettor.ewinproject.org",
    "PUBLIC_DEMO_MODE": "false",
    "EWIN_SITE_URL": "https://ewinproject.org"
  },
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Static-first routing: the pre-rendered public pages and the build
    // assets are served straight from the asset store without invoking the
    // Worker. Only the routes that genuinely need the backend are listed
    // here, so page loads stop consuming the shared Functions allowance.
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/dashboard",
      "/dashboard/*",
      "/fixtures",
      "/fixtures/*",
      "/live",
      "/live/*",
      "/odds",
      "/odds/*",
      "/predictions",
      "/predictions/*",
      "/models",
      "/models/*",
      "/scrapers",
      "/scrapers/*",
      "/analytics",
      "/analytics/*",
      "/paper",
      "/paper/*",
      "/settings",
      "/settings/*",
      "/workspace",
      "/workspace/*",
      "/admin",
      "/admin/*",
      "/sports",
      "/sports/*",
      "/betslip",
      "/betslip/*"
    ]
  },
  // Bulk provider fixtures, odds and training archives live in R2 so the
  // Convex free tier keeps only tiny control-plane metadata.
  "r2_buckets": [
    {
      "binding": "CAVEBETTOR_DATA",
      "bucket_name": "cavebettor-data"
    }
  ],
  "routes": [
    { "pattern": "cavebettor.ewinproject.org", "custom_domain": true }
  ]
}
