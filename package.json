{
  "name": "cavebettor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CaveBettor â€” harmonised sports prediction, odds intelligence and bankroll analytics workspace.",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/write-build-info.mjs && vite build && npm run verify:static",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "seed": "node scripts/seed.mjs",
    "sync:live": "tsx scripts/sync-live.ts",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:build": "node scripts/write-build-info.mjs && node scripts/build-assets.mjs",
    "assets:check": "node scripts/verify-assets.mjs",
    "assets:unique": "node scripts/check-asset-uniqueness.mjs",
    "verify:static": "node scripts/verify-static-pages.mjs",
    "production:verify": "node scripts/verify-production.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy --config wrangler.worker.jsonc",
    "deploy:pages": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name cavebettor --branch main",
    "ci": "npm run assets:unique && npm run assets:check && npm run pwa:verify && npm run check && npm test && npm run build",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "pwa:screenshots": "node scripts/capture-pwa-screenshots.mjs",
    "pwa:verify": "node scripts/verify-pwa.mjs"
  },
  "devDependencies": {
    "@cloudflare/workerd-windows-64": "^1.20261119.1",
    "@sveltejs/adapter-cloudflare": "^7.2.10",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "latest",
    "@fontsource-variable/space-grotesk": "latest",
    "@lucide/svelte": "^1.77.0",
    "cheerio": "^1.2.0",
    "clsx": "latest",
    "convex": "latest",
    "convex-svelte": "latest",
    "date-fns": "latest",
    "jspdf": "^2.5.2",
    "zod": "latest"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
