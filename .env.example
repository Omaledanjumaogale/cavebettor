# ─── CaveBettor runtime configuration ────────────────────────────────────────
# Public identity
PUBLIC_SITE_URL=https://cavebettor.ewinproject.org
PUBLIC_DEMO_MODE=false

# Convex live intelligence (optional: deterministic local engine is the fallback)
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOY_KEY=
CONVEX_HTTP_ACTIONS_URL=

# Signed server sessions and machine-to-machine sync
SESSION_SECRET=
ADMIN_SESSION_SECRET=
CAVEBETTOR_SYNC_SECRET=

# Super admin console
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# LLM narrative analyst (Agnes AI preferred; OpenAI-compatible)
AGNES_AI_KEY=
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google + GitHub OAuth
# Authorised redirect URIs:
#   https://cavebettor.ewinproject.org/auth/google/callback
#   https://cavebettor.ewinproject.org/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# E-WIN Hub single sign-on (platform id: cavebettor)
EWIN_SITE_URL=https://ewinproject.org
EWIN_CONVEX_SITE_URL=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=intelligence@ewinproject.org

# Cloudflare R2 media + Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=cavebettor-media

# Commercial data / odds APIs (optional, each one is validated independently)
API_FOOTBALL_KEY=
SPORTSDB_KEY=
THE_ODDS_API_KEY=
BALLDONTLIE_KEY=
TENNIS_API_KEY=

# Payments — Paystack (Nigeria). Plans are billed in NGN.
PAYSTACK_SECRET_KEY=
PUBLIC_PAYSTACK_PUBLIC_KEY=
CAVEBETTOR_MONTHLY_NGN=5000

# Scraper runtime. Set to "live" only where you have permission to collect.
SCRAPER_MODE=fixture
SCRAPER_USER_AGENT=CaveBettorBot/1.0 (+https://cavebettor.ewinproject.org/contact)
