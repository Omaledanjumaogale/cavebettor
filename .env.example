# ─── CaveBettor runtime configuration ────────────────────────────────────────
# Public Convex deployment (optional: the app runs on its local deterministic
# intelligence engine when this is not configured).
PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# LLM narrative analyst (optional). Without a key CaveBettor uses its
# deterministic, template-grounded match analyst.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Commercial data / odds APIs (optional, each one is validated independently)
API_FOOTBALL_KEY=
SPORTSDB_KEY=
THE_ODDS_API_KEY=
BALLDONTLIE_KEY=
TENNIS_API_KEY=

# Payments — Paystack (Nigeria). Plans are billed in NGN.
PAYSTACK_SECRET_KEY=
PUBLIC_PAYSTACK_PUBLIC_KEY=
CAVEBETTOR_MONTHLY_NGN=5000

# Scraper runtime. Set to "live" only where you have permission to collect.
SCRAPER_MODE=fixture
SCRAPER_USER_AGENT=CaveBettorBot/1.0 (+https://cavebettor.example/contact)
