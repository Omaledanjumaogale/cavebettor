/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/icons/*
  Cache-Control: public, max-age=604800

/screenshots/*
  Cache-Control: public, max-age=604800

/offline
  Cache-Control: public, max-age=0, must-revalidate

/images/generated/*
  Cache-Control: public, max-age=31536000, immutable

/images/responsive/*
  Cache-Control: public, max-age=31536000, immutable

/banners/webp/*
  Cache-Control: public, max-age=31536000, immutable

/banners/svg/*
  Cache-Control: public, max-age=31536000, immutable

/build-info.json
  Cache-Control: no-cache

/*
  # Cloudflare's injected speculation rules prerender pages on hover, which
  # costs a Worker invocation per prefetch and serves stale documents when the
  # device goes offline. An explicit empty rule set replaces the injection.
  Speculation-Rules: "[]"
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
