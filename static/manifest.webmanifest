      "label": "Value board ranked by model probability"
    },
    {
      "src": "/screenshots/dashboard-narrow.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The same command centre on a phone"
    },
    {
      "src": "/screenshots/fixtures-narrow.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Fixture board with kick-off windows and model probabilities"
    }
  ],
  "shortcuts": [
