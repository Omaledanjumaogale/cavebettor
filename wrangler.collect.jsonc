{
  "name": "cavebettor-collect-cron",
  "main": "workers/collect-cron.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "APP_URL": "https://cavebettor.ewinproject.org",
    "COLLECT_URL": "https://cavebettor.ewinproject.org/api/providers/refresh"
  },
  "triggers": {
    // Every 15 minutes. The app decides what to spend: a paced live sweep when
    // the daily allowance is ahead of schedule, or a full window refresh when
    // the fixture snapshot is more than six hours old.
    "crons": ["*/15 * * * *"]
  }
}
